<h1>Task Details</h1>

<h2><%= @task.name %></h2>

<p>
  <strong>Description:</strong>
  <%= @task.description %>
</p>

<p>
  <strong>Due Date:</strong>
  <%= @task.due_date %>
</p>

<p>
  <strong>Category:</strong>
  <%= @task.category %>
</p>

<p>
  <strong>Priority:</strong>
  <%= @task.priority %>
</p>

<hr>

<%= link_to "Edit Task", edit_task_path(@task) %>

<br><br>

<%= link_to "Back to Tasks", tasks_path %>