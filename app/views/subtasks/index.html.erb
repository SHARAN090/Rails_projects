<h1>Subtasks</h1>

<h2>Task: <%= @task.name %></h2>

<p>
  <strong>Description:</strong>
  <%= @task.description %>
</p>

<hr>

<%= link_to 'New Subtask', new_task_subtask_path(@task) %>

<hr>

<% if @subtasks.any? %>

<% @subtasks.each do |subtask| %>
<div>
    <h3><%= subtask.name %></h3>
    
    <p>
     <strong>Description:</strong>
     <%= subtask.description %>
    </p>

    <%= link_to 'Edit', edit_task_subtask_path(@task, subtask) %>
    
    |

    <%= link_to "Delete",
        task_subtask_path(@task, subtask),
        turbo_method: :delete,
        turbo_confirm: "Are you sure" } 
    %>

</div>

<hr>

<% end %>

 <p> No subtasks found. </p>

<% end %>

<%= link_to 'Back to Tasks', tasks_path(@task) %>
